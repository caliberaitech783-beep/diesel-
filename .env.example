PORT=3000
DIESEL_ACCESS_MODE=guest
DIESEL_PUBLIC_ORIGIN=http://localhost:3000
PULSE_ORIGIN=https://pulse.cmll.in
# Set the same 32-byte base64url secret on Diesel and the Pulse issuer.
DIESEL_SSO_CLIENT_SECRET=
# Comma-separated Pulse usernames permitted to open Diesel. An empty list denies all.
DIESEL_ALLOWED_PULSE_LOGINS=
# Switch to assigned-pilot after Pulse sends verified site and role assignments for Entry.
DIESEL_ENTRY_ACCESS_MODE=personal-review
# Trusted read-only approved master database on the App Service, for site-stock mode.
DIESEL_SITE_MASTER_DB=
# Optional local preview paths. Opening stock and site entries use a separate database from Master records.
DIESEL_LOCAL_MASTER_DB=
DIESEL_LOCAL_SITE_ENTRY_DB=
DIESEL_LOCAL_SITE_PORT=4323
